generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Personas y roles (login + agenda académica unificados)
// ============================================================

// Roles de acceso/clasificación de una persona. Tabla administrable desde /personas/tipos
// (antes solo "tipos de persona"; ahora también controla el acceso vía el modelo Permiso,
// que referencia `rol.nombre` como string). 'Administrador' tiene bypass hardcodeado en
// requierePermiso y nunca necesita filas en `permiso`.
model Rol {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(30)
  // Rango del rol: mayor número = más alto en la jerarquía. Al crear/editar una persona o
  // cambiarle el rol (/personas/gestion), solo se pueden asignar roles con jerarquía menor o
  // igual a la del propio usuario — ver el chequeo en server/api/personas/index.post.ts y
  // server/api/personas/[id]/rol.patch.ts. 'Administrador' tiene bypass total, igual que en
  // requierePermiso, sin importar este valor.
  jerarquia Int       @default(0)
  personas  Persona[]

  @@map("rol")
}

// Tipo de jornada laboral de un profesor (solo aplica al rol Profesor).
enum JornadaLaboral {
  COMPLETA
  PARCIAL

  @@map("jornada_laboral")
}

// Preferencia de theme de la interfaz (ver /cuenta/preferencias). Primer criterio de una
// página pensada para ir sumando otros más adelante.
enum TemaPreferido {
  CLARO
  OSCURO

  @@map("tema_preferido")
}

model Persona {
  id                 Int             @id @default(autoincrement())
  email              String          @unique @db.VarChar(50)
  // Nulo: la persona no tiene cuenta de acceso al sistema (solo agenda/reservas).
  password           String?         @db.VarChar(60)
  nombre             String          @db.VarChar(50)
  apellido           String          @db.VarChar(50)
  activo             Boolean         @default(true)
  rolId              Int             @map("rol_id")
  // Solo aplica a profesores; nulo para el resto de los roles.
  jornadaLaboral     JornadaLaboral? @map("jornada_laboral")
  // Preferencia de theme (claro/oscuro) de la persona. Se aplica al iniciar sesión y se puede
  // cambiar en /cuenta/preferencias.
  temaPreferido      TemaPreferido   @default(CLARO) @map("tema_preferido")
  // Si /horario destaca los "topes" de un paralelo dictado en más de un curso (mismo paralelo
  // espejo, no un choque real de sala/profesor — ver `topeEsEspejo` en horario/index.vue), y
  // con qué color. Se cambia en /cuenta/preferencias.
  mostrarTopesEspejo Boolean         @default(true) @map("mostrar_topes_espejo")
  colorTopesEspejo   String          @default("#06B6D4") @map("color_topes_espejo") @db.VarChar(7)
  // Nulo: sin emoji asignado. Un solo emoji (posiblemente una secuencia ZWJ de varios
  // codepoints — familia, tono de piel, etc.) elegido de
  // https://unicode.org/emoji/charts/full-emoji-list.html. Se muestra flotando sobre el
  // círculo de iniciales en el navbar (app/layouts/default.vue).
  emoji              String?         @db.VarChar(32)

  rol Rol @relation(fields: [rolId], references: [id])

  reservas             Reserva[]
  sesionesComoProfesor SesionParalelo[]
  carrerasComoJefe     Carrera[]
  carrerasAsignadas    CarreraPersona[]
  encargadoDeSalas     EncargadoSala[]

  @@index([rolId])
  @@map("persona")
}

// ============================================================
// Jerarquía académica
// ============================================================

model Carrera {
  codigo        Int     @id
  nombre        String  @unique @db.VarChar(100)
  // Nombre corto para mostrar en espacios reducidos.
  nombreCorto   String  @map("nombre_corto") @db.VarChar(30)
  jefePersonaId Int     @map("jefe_persona_id")
  // Diurna o vespertina (mismo enum `Jornada` que usa Bloque.jornada).
  jornada       Jornada @default(DIURNA)

  jefe   Persona @relation(fields: [jefePersonaId], references: [id])
  planes Plan[]

  personasAsignadas CarreraPersona[]

  @@index([jefePersonaId])
  @@map("carrera")
}

// Personas (directores de departamento, profesores, apoyo docente, …) asignadas a una
// o más carreras, más allá del jefe de carrera único (Carrera.jefePersonaId).
model CarreraPersona {
  id            Int @id @default(autoincrement())
  personaId     Int @map("persona_id")
  carreraCodigo Int @map("carrera_codigo")

  persona Persona @relation(fields: [personaId], references: [id])
  carrera Carrera @relation(fields: [carreraCodigo], references: [codigo])

  @@unique([personaId, carreraCodigo])
  @@index([carreraCodigo])
  @@map("carrera_persona")
}

model Plan {
  id                Int     @id @default(autoincrement())
  numero            Int
  vigente           Boolean @default(false)
  carreraCodigo     Int     @map("carrera_codigo")
  cantidadSemestres Int     @default(4) @map("cantidad_semestres")
  // Habilita el cuadro de electivos en /planes/asignacion para este plan. Sin esto en true,
  // el cuadro no se muestra aunque el plan ya tuviera asignaturas marcadas `esElectiva`.
  tieneElectivos    Boolean @default(false) @map("tiene_electivos")

  carrera         Carrera          @relation(fields: [carreraCodigo], references: [codigo])
  asignaturasPlan AsignaturaPlan[]
  cursos          Curso[]

  @@index([carreraCodigo])
  @@map("plan")
}

// Cohorte/generación de una carrera dentro de un plan (ej. "1er año", "2do año") en un
// semestre específico. Los paralelos se agendan en el horario de un curso específico.
model Curso {
  id             Int    @id @default(autoincrement())
  nombre         String @db.VarChar(50)
  // Número de la cohorte (1er año, 2do año, …). Constraint `curso_numero_positivo` en BD.
  numero         Int
  // Posición curricular (1..12) dentro del plan — se compara contra AsignaturaPlan.semestre
  // al crear un paralelo. Constraint `curso_numero_semestre_rango` en BD. Distinto de
  // `semestreId`, que apunta al semestre académico real (calendario).
  numeroSemestre Int    @map("numero_semestre")
  planId         Int    @map("plan_id")
  semestreId     Int    @map("semestre_id")

  plan      Plan       @relation(fields: [planId], references: [id])
  semestre  Semestre   @relation(fields: [semestreId], references: [id])
  paralelos Paralelo[]

  @@unique([planId, semestreId, nombre])
  @@index([planId])
  @@index([semestreId])
  @@map("curso")
}

model Asignatura {
  id              Int     @id @default(autoincrement())
  codigo          String  @unique @db.VarChar(20)
  nombre          String  @db.VarChar(100)
  // Nombre abreviado para espacios reducidos (ej. tarjetas de la pantalla pública). Nulo: usa
  // `nombre` completo donde haga falta.
  nombreCorto     String? @map("nombre_corto") @db.VarChar(50)
  bloquesTeoria   Int     @map("bloques_teoria")
  bloquesPractica Int     @map("bloques_practica")

  asignaturasPlan AsignaturaPlan[]
  // Las dos puntas de la misma relación simétrica (ver AsignaturaEquivalencia): para saber
  // con qué asignaturas es equivalente esta, basta con `equivalencias` — la fila inversa
  // siempre existe.
  equivalencias   AsignaturaEquivalencia[] @relation("equivalenciaOrigen")
  equivalenteDe   AsignaturaEquivalencia[] @relation("equivalenciaDestino")

  @@map("asignatura")
}

// Equivalencia entre dos asignaturas: distintos códigos que se dictan como la misma
// asignatura (ej. HCW100_T en el plan y HCW100 en la programación de un semestre). Se usa en
// la carga masiva para aceptar paralelos de un código que no está en el plan pero sí lo está
// su equivalente.
//
// La relación es **simétrica y se guarda en las dos direcciones**: dar de alta A↔B inserta
// (A,B) y (B,A). Así cualquier consulta se resuelve mirando solo `equivalencias`, sin tener
// que unir también la punta inversa. Los endpoints (`/api/asignaturas/equivalencias/toggle`)
// son los responsables de mantener el par completo.
//
// No es transitiva: si A↔B y B↔C, A y C no quedan equivalentes salvo que se indique explícito.
model AsignaturaEquivalencia {
  asignaturaId  Int @map("asignatura_id")
  equivalenteId Int @map("equivalente_id")

  asignatura  Asignatura @relation("equivalenciaOrigen", fields: [asignaturaId], references: [id], onDelete: Cascade)
  equivalente Asignatura @relation("equivalenciaDestino", fields: [equivalenteId], references: [id], onDelete: Cascade)

  @@id([asignaturaId, equivalenteId])
  @@index([equivalenteId])
  @@map("asignatura_equivalencia")
}

model AsignaturaPlan {
  id           Int     @id @default(autoincrement())
  asignaturaId Int     @map("asignatura_id")
  planId       Int     @map("plan_id")
  semestre     Int
  // Posición dentro de la columna (planId, semestre) en el tablero de asignación;
  // ordenable a mano (drag and drop) en /planes/asignacion.
  orden        Int     @default(0)
  // Asignatura electiva dentro de este plan: en vez de vivir en la columna de su `semestre`,
  // se ubica en el cuadro de Electivos de /planes/asignacion, y en /paralelos/asignacion se
  // puede crear su paralelo en un curso de cualquier semestre (sin la advertencia de "el
  // semestre no coincide"). `semestre` se conserva igual (>=1, exigido por la BD) pero deja
  // de usarse para agrupar la asignatura en una columna del tablero.
  esElectiva   Boolean @default(false) @map("es_electiva")
  // Omite las advertencias de topes de horario (choque de sala o de profesor) en las
  // sesiones de esta asignatura, para este plan — ver /configuracion. Es por (asignatura,
  // plan): la misma asignatura puede estar exenta en un plan y no en otro.
  exentaTope   Boolean @default(false) @map("exenta_tope")

  asignatura Asignatura @relation(fields: [asignaturaId], references: [id])
  plan       Plan       @relation(fields: [planId], references: [id])
  paralelos  Paralelo[]

  @@unique([asignaturaId, planId])
  @@index([planId])
  @@map("asignatura_plan")
}

model Paralelo {
  id               Int     @id @default(autoincrement())
  codigo           String  @db.VarChar(10)
  // Cupo de estudiantes del paralelo. Constraint `paralelo_cupo_rango` en BD (0 a 100).
  cupo             Int     @default(0)
  // Posición dentro de su curso (cursoId) en el tablero de /paralelos/asignacion;
  // ordenable a mano (drag and drop).
  orden            Int     @default(0)
  // Color (hex, ej. "#3B82F6") de los bloques de este paralelo en la matriz de horario.
  // Nulo: usa el color por defecto según el tipo de sesión (teoría/práctica).
  color            String? @db.VarChar(7)
  asignaturaPlanId Int     @map("asignatura_plan_id")
  cursoId          Int     @map("curso_id")

  asignaturaPlan AsignaturaPlan   @relation(fields: [asignaturaPlanId], references: [id])
  curso          Curso            @relation(fields: [cursoId], references: [id])
  sesiones       SesionParalelo[]

  @@index([asignaturaPlanId])
  @@index([cursoId])
  @@map("paralelo")
}

// ============================================================
// Temporal (semestre y bloques versionados)
// ============================================================

model Semestre {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(20)
  fechaInicio DateTime @map("fecha_inicio") @db.Date
  fechaFin    DateTime @map("fecha_fin") @db.Date
  vigente     Boolean  @default(false)

  cursos   Curso[]
  bloques  Bloque[]
  feriados Feriado[]

  @@map("semestre")
}

// Qué se suspende en un feriado: solo las clases (permite reuniones y otras actividades)
// o todo (clases y actividades por igual).
enum AlcanceFeriado {
  SOLO_CLASES
  TOTAL

  @@map("alcance_feriado")
}

// Feriado (día completo o solo un rango horario) dentro de un semestre. Constraint
// `feriado_horas_validas` en BD (ver CLAUDE.md raíz): hora_inicio y hora_termino van
// ambos null (día completo) o ambos con valor y hora_termino > hora_inicio.
model Feriado {
  id          Int            @id @default(autoincrement())
  fecha       DateTime       @db.Date
  horaInicio  DateTime?      @map("hora_inicio") @db.Time
  horaTermino DateTime?      @map("hora_termino") @db.Time
  alcance     AlcanceFeriado @default(TOTAL)
  semestreId  Int            @map("semestre_id")

  semestre Semestre @relation(fields: [semestreId], references: [id])

  // Un mismo semestre no puede tener dos feriados en la misma fecha.
  @@unique([semestreId, fecha])
  @@index([semestreId])
  @@map("feriado")
}

enum Jornada {
  DIURNA
  VESPERTINA

  @@map("jornada")
}

model Bloque {
  id             Int      @id @default(autoincrement())
  semestreId     Int      @map("semestre_id")
  numero         Int
  inicio         DateTime @db.Time
  fin            DateTime @db.Time
  jornada        Jornada  @default(DIURNA)
  // Marca el último bloque de la mañana (separa mañana/tarde en la matriz de horario).
  // Invariante `bloque_un_ultimo_manana_por_semestre` en BD: a lo más un bloque en true
  // por semestre (índice único parcial, no representable en Prisma).
  esUltimoManana Boolean  @default(false) @map("es_ultimo_manana")

  semestre       Semestre               @relation(fields: [semestreId], references: [id])
  sesionesBloque SesionParaleloBloque[]
  protecciones   BloqueProtegido[]

  @@unique([semestreId, numero])
  @@index([semestreId])
  @@map("bloque")
}

// Un bloque queda "protegido" (sin poder agendar clases de paralelos) en un día
// específico si existe una fila aquí. Ej: bloques 7 y 8 protegidos martes y jueves.
// diaSemana usa numeración ISO: 1 = Lunes … 7 = Domingo.
model BloqueProtegido {
  bloqueId  Int @map("bloque_id")
  diaSemana Int @map("dia_semana") @db.SmallInt

  bloque Bloque @relation(fields: [bloqueId], references: [id], onDelete: Cascade)

  @@id([bloqueId, diaSemana])
  @@map("bloque_protegido")
}

// ============================================================
// Sesiones (plantilla horaria del paralelo)
// ============================================================

enum TipoSesion {
  TEORIA
  PRACTICA

  @@map("tipo_sesion")
}

model SesionParalelo {
  id         Int        @id @default(autoincrement())
  paraleloId Int        @map("paralelo_id")
  diaSemana  Int        @map("dia_semana") @db.SmallInt
  tipo       TipoSesion
  salaCodigo String?    @map("sala_codigo") @db.VarChar(20)
  profesorId Int?       @map("profesor_id")

  paralelo Paralelo @relation(fields: [paraleloId], references: [id])
  sala     Sala?    @relation(fields: [salaCodigo], references: [codigo])
  profesor Persona? @relation(fields: [profesorId], references: [id])

  bloques  SesionParaleloBloque[]
  reservas Reserva[]

  @@index([paraleloId])
  @@index([salaCodigo])
  @@index([profesorId])
  @@map("sesion_paralelo")
}

model SesionParaleloBloque {
  sesionParaleloId Int @map("sesion_paralelo_id")
  bloqueId         Int @map("bloque_id")

  sesionParalelo SesionParalelo @relation(fields: [sesionParaleloId], references: [id], onDelete: Cascade)
  bloque         Bloque         @relation(fields: [bloqueId], references: [id])

  @@id([sesionParaleloId, bloqueId])
  @@index([bloqueId])
  @@map("sesion_paralelo_bloque")
}

// ============================================================
// Salas
// ============================================================

model TipoSala {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(50)
  salas  Sala[]

  @@map("tipo_sala")
}

model Sala {
  codigo     String @id @db.VarChar(20)
  capacidad  Int
  tipoSalaId Int    @map("tipo_sala_id")

  tipoSala   TipoSala              @relation(fields: [tipoSalaId], references: [id])
  encargados EncargadoSala[]
  sesiones   SesionParalelo[]
  reservas   Reserva[]
  pantallas  PantallaPublicaSala[]

  @@index([tipoSalaId])
  @@map("sala")
}

model EncargadoSala {
  id         Int    @id @default(autoincrement())
  personaId  Int    @map("persona_id")
  salaCodigo String @map("sala_codigo") @db.VarChar(20)

  persona Persona @relation(fields: [personaId], references: [id])
  sala    Sala    @relation(fields: [salaCodigo], references: [codigo])

  @@unique([personaId, salaCodigo])
  @@index([salaCodigo])
  @@map("encargado_sala")
}

// Pantalla física en un lugar público (hall, pasillo…) que muestra en loop el horario de la
// semana de una o más salas. `codigo` identifica la ruta pública /pantallas/<codigo> — no es
// la PK (por si algún día conviene reasignarlo sin arrastrar el id), pero es único e
// insensible a mayúsculas en la búsqueda (ver server/api/pantallas/publico/[codigo].get.ts).
model PantallaPublica {
  id               Int    @id @default(autoincrement())
  nombre           String @db.VarChar(60)
  codigo           String @unique @db.VarChar(20)
  // Segundos que cada sala permanece en pantalla antes de pasar a la siguiente.
  segundosPorSlide Int    @default(15) @map("segundos_por_slide")
  // Cuántas próximas clases se muestran por sala en la pantalla pública. Nulo = todas las que
  // queden por comenzar hoy (opción "Todas" en /salas/pantallas) — es también el valor con el
  // que quedan las pantallas ya creadas al agregar esta columna, para no cambiarles el
  // comportamiento actual.
  proximasPorSala  Int?   @map("proximas_por_sala")

  salas PantallaPublicaSala[]

  @@map("pantalla_publica")
}

model PantallaPublicaSala {
  id         Int    @id @default(autoincrement())
  pantallaId Int    @map("pantalla_id")
  salaCodigo String @map("sala_codigo") @db.VarChar(20)

  pantalla PantallaPublica @relation(fields: [pantallaId], references: [id], onDelete: Cascade)
  sala     Sala            @relation(fields: [salaCodigo], references: [codigo])

  @@unique([pantallaId, salaCodigo])
  @@index([salaCodigo])
  @@map("pantalla_publica_sala")
}

// ============================================================
// Reservas
// ============================================================

model TipoReserva {
  id                Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(30)
  // Hex de una paleta fija de 20 colores con nombre (ver COLORES_RESERVA en
  // app/types/reserva.ts): cada reserva de este tipo toma este color en /reservas/horario.
  color             String    @db.VarChar(7)
  // Valor por defecto de Reserva.publica para una reserva nueva de este tipo: se usa al
  // prellenar el formulario de nueva reserva en /reservas/horario y al generar las reservas
  // de sala de una sesión de clases (ver regenerarReservaSesion en reservasSesion.ts y la
  // carga masiva de horario en cargaMasiva.ts). Cambiar este valor no toca las reservas ya
  // creadas de ese tipo, solo el default para las nuevas.
  publicaPorDefecto Boolean   @default(true) @map("publica_por_defecto")
  reservas          Reserva[]

  @@map("tipo_reserva")
}

model Reserva {
  id               Int      @id @default(autoincrement())
  salaCodigo       String   @map("sala_codigo") @db.VarChar(20)
  titulo           String   @db.VarChar(50)
  fecha            DateTime @db.Date
  inicio           DateTime @db.Time
  fin              DateTime @db.Time
  // Nulo: reserva sin responsable designado. Pasa con las reservas generadas por una sesión
  // de clases a la que todavía no se le asigna profesor (la sala ya queda tomada igual);
  // al asignarlo, la serie se regenera con el profesor como responsable.
  personaId        Int?     @map("persona_id")
  tipoReservaId    Int      @map("tipo_reserva_id")
  sesionParaleloId Int?     @map("sesion_paralelo_id")
  // Comparte un mismo serieId todas las ocurrencias generadas por una reserva recurrente
  // (semanal); null en una reserva no recurrente. No hay un campo booleano "recurrente"
  // aparte: la recurrencia se sabe por si serieId es null o no.
  serieId          String?  @map("serie_id") @db.Uuid
  // Si la reserva se muestra en vistas de cara al público: la vista impresa de
  // /reservas/horario y la pantalla pública (/pantallas/<codigo>). Por defecto sí — se marca
  // en false para reservas que deben tomar la sala en la BD pero no anunciarse (p. ej.
  // bloqueos internos de mantenimiento).
  publica          Boolean  @default(true)
  // Reserva cancelada: a diferencia de borrarla, queda visible (destacada en rojo) en
  // /reservas/horario y en la pantalla pública — sirve para avisar que una clase puntual no se
  // dicta ese día sin perder el registro de que la sala estaba tomada. No aplica a la serie
  // completa de una reserva recurrente, solo a esta ocurrencia — ver
  // server/api/reservas/[id]/cancelar.patch.ts.
  cancelada        Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sala           Sala            @relation(fields: [salaCodigo], references: [codigo])
  persona        Persona?        @relation(fields: [personaId], references: [id])
  tipoReserva    TipoReserva     @relation(fields: [tipoReservaId], references: [id])
  sesionParalelo SesionParalelo? @relation(fields: [sesionParaleloId], references: [id])

  @@index([salaCodigo, fecha])
  @@index([personaId])
  @@index([sesionParaleloId])
  @@index([fecha])
  @@index([serieId])
  @@map("reserva")
}

// ============================================================
// Trabajos de título (propuestas)
// ============================================================
//
// Módulo para administrar propuestas de trabajo de título de estudiantes, separado del
// login unificado de Persona: estudiantes y profesores de este módulo (`TtEstudiante`,
// `TtProfesor`) son entidades propias, con su propia credencial — no reutilizan `Persona`.
// Prefijo `Tt` en los modelos (tabla `tt_*`) para diferenciarlos del resto del dominio
// académico y evitar choques de nombre (p. ej. `TtRol` es un catálogo de roles dentro de
// una propuesta, sin relación con el `Rol` de acceso al sistema).

model TtProceso {
  id   Int @id @default(autoincrement())
  // "año" en el diagrama original; sin tilde acá por consistencia con el resto del schema
  // (identificadores en ASCII).
  anio Int

  estudiantes TtEstudiante[]
  grupos      TtGrupo[]

  @@map("tt_proceso")
}

model TtGrupo {
  id        Int    @id @default(autoincrement())
  nombre    String @db.VarChar(50)
  // Constraint `tt_grupo_numero_positivo` en BD (>= 1) y unique compuesto con procesoId acá
  // abajo: no se puede repetir el número dentro del mismo proceso, pero sí entre procesos
  // distintos (cada proceso numera sus propios grupos desde 1).
  numero    Int
  procesoId Int    @map("proceso_id")

  proceso     TtProceso      @relation(fields: [procesoId], references: [id])
  estudiantes TtEstudiante[]

  @@unique([procesoId, numero])
  @@index([procesoId])
  @@map("tt_grupo")
}

model TtEstudiante {
  email           String @id @db.VarChar(50)
  run             String @unique @db.VarChar(10)
  password        String @db.VarChar(60)
  nombres         String @db.VarChar(50)
  apellidoPaterno String @map("apellido_paterno") @db.VarChar(50)
  apellidoMaterno String @map("apellido_materno") @db.VarChar(50)
  procesoId       Int    @map("proceso_id")
  // Nulo: el estudiante todavía no está asignado a un grupo de trabajo.
  grupoId         Int?   @map("grupo_id")

  proceso    TtProceso     @relation(fields: [procesoId], references: [id])
  grupo      TtGrupo?      @relation(fields: [grupoId], references: [id])
  propuestas TtPropuesta[]

  @@index([procesoId])
  @@index([grupoId])
  @@map("tt_estudiante")
}

model TtProfesor {
  email          String  @id @db.VarChar(50)
  run            String  @unique @db.VarChar(10)
  nombre         String  @db.VarChar(30)
  apellido       String  @db.VarChar(30)
  esGuia         Boolean @map("es_guia")
  esInvestigador Boolean @map("es_investigador")

  comisiones          TtComision[]
  lineasInvestigacion TtLineaInvestigacionProfesor[]

  @@map("tt_profesor")
}

model TtLineaInvestigacion {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(50)

  propuestas TtPropuesta[]
  profesores TtLineaInvestigacionProfesor[]

  @@map("tt_linea_investigacion")
}

// Profesores que trabajan en una línea de investigación — de qué líneas puede ser guía o
// evaluador un profesor.
model TtLineaInvestigacionProfesor {
  lineaInvestigacionId Int    @map("linea_investigacion_id")
  profesorEmail        String @map("profesor_email") @db.VarChar(50)

  lineaInvestigacion TtLineaInvestigacion @relation(fields: [lineaInvestigacionId], references: [id])
  profesor           TtProfesor           @relation(fields: [profesorEmail], references: [email])

  @@id([lineaInvestigacionId, profesorEmail])
  @@index([profesorEmail])
  @@map("tt_linea_investigacion_profesor")
}

// Catálogo de roles dentro de una propuesta (p. ej. quién la presenta) — sin relación con
// el modelo `Rol` de acceso al sistema.
model TtRol {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(100)
  descripcion String? @db.VarChar(200)
  activo      Boolean @default(true)

  propuestas TtPropuesta[]

  @@map("tt_rol")
}

model TtPropuesta {
  id                   Int      @id @default(autoincrement())
  titulo               String   @db.VarChar(250)
  fecha                DateTime
  // 3 modalidades fijas ("Investigación" / "Tesina Feria de Software" / "Proyecto Propio"),
  // validadas por enum en el endpoint (ver MODALIDADES_PROPUESTA en titulaciones.schemas.ts) —
  // texto libre en la BD, igual que TipoReserva.nombre, no un enum de Postgres.
  modalidad            String   @db.VarChar(30)
  descripcion          String
  // Solo se completan según la modalidad elegida: inv_* si es "Investigación", cla_* si es
  // "Proyecto Propio" — nulos en cualquier otro caso (incluida "Tesina Feria de Software", que
  // no tiene campos propios). Se valida en el endpoint, no acá (Prisma no modela CHECK
  // condicionales — ver la sección de invariantes de BD en el CLAUDE.md raíz).
  invMotivacion        String?  @map("inv_motivacion")
  invExperiencia       String?  @map("inv_experiencia")
  claProblema          String?  @map("cla_problema")
  claObjetivo          String?  @map("cla_objetivo")
  // Si la propuesta tiene cambios pendientes de revisión frente a la última versión evaluada.
  hayCambios           Boolean  @default(false) @map("hay_cambios")
  // Solo aplica a "Tesina Feria de Software" — nulo en cualquier otra modalidad.
  rolId                Int?     @map("rol_id")
  estudianteEmail      String   @map("estudiante_email") @db.VarChar(50)
  // Solo aplica a "Investigación" — nulo en cualquier otra modalidad.
  lineaInvestigacionId Int?     @map("linea_investigacion_id")

  rol                TtRol?                @relation(fields: [rolId], references: [id])
  estudiante         TtEstudiante          @relation(fields: [estudianteEmail], references: [email])
  lineaInvestigacion TtLineaInvestigacion? @relation(fields: [lineaInvestigacionId], references: [id])
  estados            TtEstado[]
  comision           TtComision[]

  @@index([rolId])
  @@index([estudianteEmail])
  @@index([lineaInvestigacionId])
  @@map("tt_propuesta")
}

// Historial de estados de una propuesta (enviada, en revisión, aprobada, rechazada, …): una
// fila por cambio de estado, no un solo campo `estado` en TtPropuesta, para conservar el
// historial completo con fecha y comentario de cada transición.
model TtEstado {
  id             Int       @id @default(autoincrement())
  fechaHora      DateTime  @map("fecha_hora")
  // "Pendiente" / "Aceptada" / "Rechazada" / "Antecedentes solicitados" (ver
  // ESTADOS_DECISION_PROPUESTA en titulaciones.schemas.ts) — "Antecedentes solicitados" (24
  // caracteres) no entraba en el VarChar(20) original.
  estado         String    @db.VarChar(30)
  // Nulo: no toda transición de estado trae un comentario (p. ej. una automática).
  comentario     String?
  // Nulo = no visto. Se completa cuando el estudiante abre el detalle de la propuesta y ese
  // estado todavía no tenía marca (ver POST /api/estudiante/propuestas/[id]/marcar-visto). El
  // "Pendiente" que nace junto con la propuesta se marca visto de inmediato — el propio
  // estudiante la acaba de crear, no es una novedad para él.
  vistoFechaHora DateTime? @map("visto_fecha_hora")
  propuestaId    Int       @map("propuesta_id")

  propuesta TtPropuesta @relation(fields: [propuestaId], references: [id])

  @@index([propuestaId])
  @@map("tt_estado")
}

// Comisión evaluadora de una propuesta: qué profesores la integran y con qué rol (p. ej.
// "Guía", "Presidente", "Revisor" — texto libre, no FK a TtRol).
model TtComision {
  propuestaId   Int    @map("propuesta_id")
  profesorEmail String @map("profesor_email") @db.VarChar(50)
  rol           String @db.VarChar(20)

  propuesta TtPropuesta @relation(fields: [propuestaId], references: [id])
  profesor  TtProfesor  @relation(fields: [profesorEmail], references: [email])

  @@id([propuestaId, profesorEmail])
  @@index([profesorEmail])
  @@map("tt_comision")
}

// ============================================================
// Permisos
// ============================================================

// Controla qué rol puede ejecutar qué acción sobre qué ruta.
// 'Administrador' nunca tiene filas aquí: tiene bypass hardcodeado en requierePermiso
// para que nunca pueda quedar bloqueado por un seed o borrado accidental.
model Permiso {
  id     Int    @id @default(autoincrement())
  rol    String @db.VarChar(30)
  ruta   String @db.VarChar(50)
  accion String @db.VarChar(10) // 'ver' | 'crear' | 'editar' | 'borrar' | 'contrasena' | 'cambiarrol' | 'activar'

  @@unique([rol, ruta, accion], name: "rol_ruta_accion")
  @@index([rol])
  @@map("permiso")
}
