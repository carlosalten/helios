{
   "folders": [
      { "name": "🏠 Raíz del monorepo", "path": "." },
      { "name": "🔐 auth-service", "path": "packages/auth-service" },
      { "name": "📊 reportes-service", "path": "packages/reportes-service" },
      { "name": "🏢 horario-service", "path": "packages/horario-service" },
      { "name": "🖥 frontend", "path": "packages/frontend" },
   ],
   "settings": {
      "typescript.tsdk": "node_modules/typescript/lib",
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.patterns": {
         "*.ts": "${capture}.js, ${capture}.d.ts",
         "nuxt.config.*": ".nuxtrc, .nuxtignore",
         "package.json": "package-lock.json, .npmrc",
      },
   },
   "extensions": {
      "recommendations": [
         "Vue.volar",
         "dbaeumer.vscode-eslint",
         "esbenp.prettier-vscode",
         "Prisma.prisma",
         "mikestead.dotenv",
      ],
   },
}
